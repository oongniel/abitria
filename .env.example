# Where data is saved: "sheets" = Google Sheets, anything else = this browser only
NEXT_PUBLIC_STORAGE=sheets

# Google Sheets (see docs/google-sheets.md)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences, in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The owner's passcode. Protects the app and its data API, and turns on sign-in.
# Strongly recommended once deployed — without it the app is open to anyone.
APP_PASSCODE=

# Optional second sign-in for a seller: records sales, and never receives cost,
# capital, expenses or profit from the server. Leave blank for no seller.
# Must differ from APP_PASSCODE.
SELLER_PASSCODE=

# Try Sheets mode locally with an in-memory sheet (no Google needed). Resets on restart.
# GOOGLE_SHEETS_FAKE=1
