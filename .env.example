# Where data is saved: "sheets" = Google Sheets, anything else = this browser only
NEXT_PUBLIC_STORAGE=sheets

# Google Sheets (see docs/google-sheets.md)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences, in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Protects the app and its data API. Strongly recommended once deployed.
APP_PASSCODE=

# Try Sheets mode locally with an in-memory sheet (no Google needed). Resets on restart.
# GOOGLE_SHEETS_FAKE=1
